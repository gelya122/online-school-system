<UserControl x:Class="online_school_admin.Views.SectionStubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="560" VerticalAlignment="Top">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Text="{Binding Title}" />
        <TextBlock Margin="0,12,0,0"
                   FontSize="14"
                   Foreground="#6B7280"
                   Text="{Binding Hint}"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
