<Window x:Class="online_school_admin.Views.CourseInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поток курса"
        Height="520"
        Width="560"
        MinHeight="480"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Настройка потока" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Text="Поток — конкретный запуск шаблона курса (даты, расписание, лимиты). Уроки и ДЗ задаются в шаблоне." />
            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding CourseTitle, StringFormat=Шаблон: {0}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,4" Text="Название потока" />
                <TextBox Margin="0,0,0,12" Padding="8,6" Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,4" Text="Дата начала" />
                        <DatePicker SelectedDate="{Binding StartDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,4" Text="Дата окончания" />
                        <DatePicker SelectedDate="{Binding EndDate}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,4" Text="Недель (план)" />
                        <TextBox Padding="8,6" Text="{Binding TotalWeeks, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,4" Text="Уроков в неделю" />
                        <TextBox Padding="8,6" Text="{Binding LessonsPerWeek, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,0,0,4" Text="Описание расписания" />
                <TextBox Margin="0,0,0,12"
                         MinHeight="72"
                         Padding="8,6"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Text="{Binding ScheduleDescription, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,0,0,4" Text="Макс. студентов" />
                <TextBox Margin="0,0,0,12" Padding="8,6" Text="{Binding MaxStudents, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="Поток активен (набор/проведение)" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Padding="16,8"
                    Content="Сохранить"
                    Command="{Binding SaveAsyncCommand}" />
            <Button Padding="16,8"
                    Content="Закрыть"
                    IsCancel="True"
                    IsDefault="False" />
        </StackPanel>
    </Grid>
</Window>
