<UserControl x:Class="online_school_admin.Views.StudentEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:online_school_admin.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Редактирование студента" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCreate}" Value="True">
                                <Setter Property="Text" Value="Добавление студента" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Margin="0,0,0,12" Foreground="#C0392B" Text="{Binding Error}" TextWrapping="Wrap" />

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Имя *" />
                    <TextBox Padding="8,6" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Фамилия *" />
                    <TextBox Padding="8,6" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </UniformGrid>

            <TextBlock Margin="0,12,0,0" Text="Email *" />
            <TextBox Padding="8,6" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <Border Margin="0,12,0,0" Padding="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCreate}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Пароль для входа ученика *" />
                    <PasswordBox Margin="0,6,0,0"
                                 Padding="8,6"
                                 i:PasswordBoxHelper.BindPassword="True"
                                 i:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,12,0,0" Text="Телефон" />
            <TextBox Padding="8,6" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

            <UniformGrid Columns="2" Margin="0,12,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Дата рождения" />
                    <DatePicker SelectedDate="{Binding BirthDate, Mode=TwoWay}" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Класс" />
                    <TextBox Padding="8,6" Text="{Binding ClassNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="2" Margin="0,12,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Телефон родителя" />
                    <TextBox Padding="8,6" Text="{Binding ParentPhone, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Email родителя" />
                    <TextBox Padding="8,6" Text="{Binding ParentEmail, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </UniformGrid>

            <TextBlock Margin="0,12,0,0" Text="Аватар URL" />
            <TextBox Padding="8,6" Text="{Binding AvatarUrl, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="0,8,0,0" Padding="12,6" Content="Загрузить аватар из файла…" Command="{Binding PickAvatarCommand}" />
            
            <CheckBox Margin="0,12,0,0"
                      Content="Учётная запись активна"
                      IsChecked="{Binding IsActive}"
                      ToolTip="При записи на поток сервер может автоматически включать учётку, если есть активные курсы" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Margin="0,0,8,0" Padding="12,6" Content="Отмена" Command="{Binding CancelCommand}" />
                <Button Padding="12,6" Content="Сохранить" Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

