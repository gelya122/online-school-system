<UserControl x:Class="online_school_admin.Views.CourseDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:online_school_admin.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Foreground="#6B7280" FontSize="13" Text="{Binding BreadcrumbText}" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"
                           Text="{Binding PageTitle}" />
                <Button Margin="16,0,0,0" Padding="12,6" VerticalAlignment="Center"
                        Content="Отменить изменения"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding ShowSaveToolbar, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}"
                        Content="Сохранить изменения"
                        Command="{Binding SaveCommand}"
                        Visibility="{Binding ShowSaveToolbar, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Margin="16,0,0,0" Padding="12,6" VerticalAlignment="Center"
                        Content="Редактировать"
                        Command="{Binding SwitchToEditCommand}"
                        Visibility="{Binding ShowEditToolbarButton, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Margin="12,0,0,0" Padding="12,6" VerticalAlignment="Center"
                        Content="Обновить"
                        Command="{Binding RefreshCommand}" />
                <Button Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center"
                        Content="Создать поток из курса"
                        Command="{Binding CreateInstanceCommand}"
                        Visibility="{Binding ShowCreateInstanceButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Text="{Binding CatalogActivityHint}"
                       Visibility="{Binding HasPersistedCourse, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <TabControl>
            <TabItem Header="Основная информация">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Margin="0,12,0,0" Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBoolConverter}}">
                            <TextBlock Style="{StaticResource FormCaptionTextBlock}" Text="Категория *" />
                            <ComboBox DisplayMemberPath="CategoryName"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}" />

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Название курса *" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Краткое описание" />
                            <TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Полное описание" />
                            <TextBox AcceptsReturn="True"
                                     MinHeight="120"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                            <UniformGrid Margin="0,12,0,0" Columns="2">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FormCaptionTextBlock}" Text="Цена" />
                                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormCaptionTextBlock}" Text="Цена со скидкой" />
                                    <TextBox Text="{Binding DiscountPrice, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Обложка (URL)" />
                            <TextBox Text="{Binding CoverImgUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <Button Padding="12,6" Content="Загрузить с устройства…" Command="{Binding PickCoverCommand}" />
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#6B7280"
                                           Text="{Binding CoverFileName}" />
                            </StackPanel>

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Количество часов" />
                            <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding TotalHours, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Что получает ученик" />
                            <TextBox AcceptsReturn="True"
                                     MinHeight="80"
                                     Text="{Binding WhatYouGet, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            </StackPanel>

                            <!-- Режим просмотра: те же поля read-only -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding IsViewMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FormCaptionTextBlock}" Text="Категория" />
                            <TextBlock Foreground="#374151" Text="{Binding Details.CategoryName}" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Название" />
                            <TextBlock Foreground="#374151" Text="{Binding Details.Title}" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Краткое описание" />
                            <TextBlock Foreground="#374151" Text="{Binding Details.ShortDescription}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Полное описание" />
                            <TextBlock Foreground="#374151" Text="{Binding Details.Description}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Цена / со скидкой" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Foreground="#374151" Text="{Binding Details.Price, StringFormat={}{0:N0} ₽}" />
                                <TextBlock Foreground="#374151" Margin="6,0,6,0" Text="/" />
                                <TextBlock Foreground="#374151" Text="{Binding Details.DiscountPrice, StringFormat={}{0:N0} ₽}" />
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Обложка (URL)" />
                            <TextBlock Foreground="#374151" Text="{Binding Details.CoverImgUrl}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Часы" />
                            <TextBlock Foreground="#374151" Text="{Binding Details.TotalHours}" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Что получает ученик" />
                            <TextBlock Foreground="#374151" Text="{Binding Details.WhatYouGet}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Структура курса">
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ShowDeferredTabsPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="#1E40AF"
                                   TextWrapping="Wrap"
                                   Text="Сохраните курс на вкладке «Основная информация». После появления идентификатора курса здесь можно добавлять блоки и уроки." />
                    </Border>
                    <views:CourseStructureView DataContext="{Binding Structure}"
                                               Visibility="{Binding HasPersistedCourse, Converter={StaticResource BoolToVisibilityConverter}}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Домашние задания">
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ShowDeferredTabsPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="#1E40AF" Text="Сводка появится после сохранения курса. Редактирование — в структуре курса (вкладка урока «Домашнее задание»)." />
                    </Border>
                    <DataGrid ItemsSource="{Binding Details.HomeworkSummaries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Visibility="{Binding HasPersistedCourse, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Блок" Binding="{Binding ModuleTitle}" Width="160" />
                            <DataGridTextColumn Header="Урок" Binding="{Binding LessonTitle}" Width="200" />
                            <DataGridTextColumn Header="ДЗ (assignment)" Binding="{Binding AssignmentTitle}" Width="*" />
                            <DataGridTextColumn Header="Вопросов" Binding="{Binding QuestionsCount}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Потоки">
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ShowDeferredTabsPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="#1E40AF" Text="Потоки будут доступны после сохранения курса." />
                    </Border>
                    <DataGrid ItemsSource="{Binding CourseStreams}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Visibility="{Binding HasPersistedCourse, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding InstanceId}" Width="70" />
                            <DataGridTextColumn Header="Название потока" Binding="{Binding Title}" Width="220" />
                            <DataGridTextColumn Header="Старт" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="100" />
                            <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="100" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Учеников" Binding="{Binding StudentsCount}" Width="90" />
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80" />
                            <DataGridTemplateColumn Header="" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,4"
                                                Content="Открыть"
                                                Command="{Binding DataContext.OpenStreamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding InstanceId}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
