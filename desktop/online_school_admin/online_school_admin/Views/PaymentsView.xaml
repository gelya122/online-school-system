<UserControl x:Class="online_school_admin.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Text="Платежи" />

        <TabControl>
            <TabItem Header="Заказы">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Padding="12,6" Content="Обновить" Command="{Binding Orders.RefreshCommand}" />
                        <Button Margin="8,0,0,0" Padding="12,6" Content="Открыть" Command="{Binding Orders.OpenCommand}" />
                        <Button Margin="8,0,0,0" Padding="12,6" Content="Редактировать" Command="{Binding Orders.OpenCommand}" />
                        <Button Margin="8,0,0,0" Padding="12,6" Content="Создать" Command="{Binding Orders.CreateCommand}" />
                        <Button Margin="8,0,0,0" Padding="12,6" Content="Оплачен" Command="{Binding Orders.MarkPaidCommand}" />
                        <Button Margin="8,0,0,0" Padding="12,6" Content="Отменить" Command="{Binding Orders.CancelCommand}" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#C0392B" Text="{Binding Orders.Error}" TextWrapping="Wrap" />

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Width="260" Padding="8,6" VerticalContentAlignment="Center"
                                 Text="{Binding Orders.Search, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="10,0,0,0" Padding="12,6" Content="Поиск" Command="{Binding Orders.RefreshCommand}" />

                        <TextBox Margin="20,0,0,0" Width="160" Padding="8,6" VerticalContentAlignment="Center"
                                 ToolTip="Новый статус"
                                 Text="{Binding Orders.StatusText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="10,0,0,0" Padding="12,6" Content="Изменить статус" Command="{Binding Orders.PatchStatusCommand}" />

                        <TextBox Margin="20,0,0,0" Width="160" Padding="8,6" VerticalContentAlignment="Center"
                                 ToolTip="Промокод"
                                 Text="{Binding Orders.PromoCodeText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="10,0,0,0" Padding="12,6" Content="Применить промокод" Command="{Binding Orders.ApplyPromoCommand}" />
                    </WrapPanel>

                    <DataGrid ItemsSource="{Binding Orders.Rows}"
                              SelectedItem="{Binding Orders.Selected}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="160" />
                            <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="200" />
                            <DataGridTextColumn Header="Курс" Binding="{Binding CourseTitle}" Width="200" />
                            <DataGridTextColumn Header="Поток" Binding="{Binding InstanceTitle}" Width="200" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount}" Width="100" />
                            <DataGridTextColumn Header="Скидка" Binding="{Binding DiscountAmount}" Width="100" />
                            <DataGridTextColumn Header="Итого" Binding="{Binding FinalAmount}" Width="100" />
                            <DataGridTextColumn Header="Промокод" Binding="{Binding PromoCode}" Width="110" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110" />
                            <DataGridTextColumn Header="Способ" Binding="{Binding Method}" Width="120" />
                            <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150" />
                            <DataGridTextColumn Header="Оплачен" Binding="{Binding PaidAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Платежи">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Padding="12,6" Content="Обновить" Command="{Binding Payments.RefreshCommand}" />
                        <Button Margin="8,0,0,0" Padding="12,6" Content="Создать вручную" Command="{Binding Payments.CreateCommand}"
                                ToolTip="Если выбран платёж в таблице — в форму подставится его заказ" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#C0392B" Text="{Binding Payments.Error}" TextWrapping="Wrap" />

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Width="180" Padding="8,6" VerticalContentAlignment="Center"
                                 ToolTip="Новый статус платежа (payment_status)"
                                 Text="{Binding Payments.StatusText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="10,0,0,0" Padding="12,6" Content="Изменить статус" Command="{Binding Payments.PatchStatusCommand}" />

                        <TextBox Width="120" Margin="24,0,0,0" Padding="8,6" VerticalContentAlignment="Center"
                                 ToolTip="Новый ID заказа (app_order)"
                                 Text="{Binding Payments.NewOrderIdText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="10,0,0,0" Padding="12,6" Content="Привязать к заказу" Command="{Binding Payments.PatchOrderLinkCommand}" />
                    </WrapPanel>

                    <DataGrid ItemsSource="{Binding Payments.Rows}"
                              SelectedItem="{Binding Payments.Selected}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding PaymentId}" Width="80" />
                            <DataGridTextColumn Header="Заказ ID" Binding="{Binding OrderId}" Width="90" />
                            <DataGridTextColumn Header="Заказ" Binding="{Binding OrderNumber}" Width="160" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="100" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Способ" Binding="{Binding Method}" Width="120" />
                            <DataGridTextColumn Header="Внешний ID" Binding="{Binding ExternalPaymentId}" Width="160" />
                            <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150" />
                            <DataGridTextColumn Header="Дата оплаты" Binding="{Binding PaidAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Рассрочки">
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Padding="12,6" Content="Обновить" Command="{Binding Installments.RefreshCommand}" />
                        <Button Margin="8,0,0,0" Padding="12,6" Content="Создать план" Command="{Binding Installments.CreatePlanCommand}" />
                        <Button Margin="8,0,0,0" Padding="12,6" Content="Открыть план" Command="{Binding Installments.OpenPlanCommand}" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#C0392B" Text="{Binding Installments.Error}" TextWrapping="Wrap" />

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Width="180" Padding="8,6" VerticalContentAlignment="Center"
                                 ToolTip="Новый статус плана рассрочки (строка)"
                                 Text="{Binding Installments.StatusText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="10,0,0,0" Padding="12,6" Content="Изменить статус плана" Command="{Binding Installments.PatchStatusCommand}" />
                    </WrapPanel>

                    <DataGrid ItemsSource="{Binding Installments.Rows}"
                              SelectedItem="{Binding Installments.Selected}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Заказ" Binding="{Binding OrderNumber}" Width="180" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount}" Width="110" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding InstallmentCount}" Width="80" />
                            <DataGridTextColumn Header="Ежемесячно" Binding="{Binding MonthlyPayment}" Width="110" />
                            <DataGridTextColumn Header="Следующий платёж" Binding="{Binding NextPaymentDate, StringFormat=dd.MM.yyyy}" Width="140" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

