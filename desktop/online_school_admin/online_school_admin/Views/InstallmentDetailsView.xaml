<UserControl x:Class="online_school_admin.Views.InstallmentDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="Рассрочка" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Назад" Command="{Binding BackCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="#C0392B" Text="{Binding Error}" TextWrapping="Wrap" />

        <Border DockPanel.Dock="Top" Padding="16" Margin="0,0,0,12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Details.PlanId, StringFormat=План #{0}}" />
                <TextBlock Margin="0,6,0,0" Foreground="#6B7280" Text="{Binding Details.OrderId, StringFormat=Заказ ID: {0}}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding Details.TotalAmount, StringFormat=Сумма: {0}}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding Details.InstallmentCount, StringFormat=Платежей: {0}}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding Details.MonthlyPayment, StringFormat=Платёж: {0}}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding Details.NextPaymentDate, StringFormat=Следующая дата: {0:dd.MM.yyyy}, TargetNullValue=-}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding Details.Status, StringFormat=Статус плана: {0}}" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Статус выбранного платежа рассрочки" />
            <WrapPanel>
                <TextBox Width="200" Padding="8,6" VerticalContentAlignment="Center"
                         ToolTip="Фрагмент названия статуса из payment_status"
                         Text="{Binding PaymentStatusText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Margin="10,0,0,0" Padding="12,6" VerticalAlignment="Center" Content="Изменить статус" Command="{Binding PatchPaymentStatusCommand}" />
            </WrapPanel>
        </StackPanel>

        <DataGrid ItemsSource="{Binding PaymentRows}"
                  SelectedItem="{Binding SelectedPayment}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding InstallmentNumber}" Width="50" />
                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="110" />
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="100" />
                <DataGridTextColumn Header="Статус (строка)" Binding="{Binding PaymentStatus}" Width="120" />
                <DataGridTextColumn Header="Статус (справочник)" Binding="{Binding StatusName}" Width="160" />
                <DataGridTextColumn Header="Оплачен" Binding="{Binding PaidAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
