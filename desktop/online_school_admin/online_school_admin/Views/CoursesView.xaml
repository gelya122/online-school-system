<UserControl x:Class="online_school_admin.Views.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitleTextBlock}" Text="Курсы" />

            <WrapPanel Margin="0,10,0,0">
                <TextBox Width="260"
                         Margin="0,0,8,8"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         ToolTip="Поиск по названию"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Width="220"
                          Margin="0,0,8,8"
                          Padding="8,5"
                          DisplayMemberPath="CategoryName"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}" />

                <ComboBox Width="180"
                          Margin="0,0,8,8"
                          Padding="8,5"
                          DisplayMemberPath="SubjectName"
                          ItemsSource="{Binding Subjects}"
                          SelectedItem="{Binding SelectedSubject}" />

                <ComboBox Width="160"
                          Margin="0,0,8,8"
                          Padding="8,5"
                          DisplayMemberPath="ExamName"
                          ItemsSource="{Binding Exams}"
                          SelectedItem="{Binding SelectedExam}" />

                <ComboBox Width="160"
                          Margin="0,0,8,8"
                          Padding="8,5"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding IsActiveFilter}">
                    <ComboBoxItem Content="Все" Tag="{x:Null}" />
                    <ComboBoxItem Content="Активные" Tag="True" />
                    <ComboBoxItem Content="Скрытые" Tag="False" />
                </ComboBox>

                <Button Margin="0,0,8,8" Padding="12,6" Content="Добавить курс" Command="{Binding AddCommand}" />
                <Button Margin="0,0,8,8"
                        Padding="12,6"
                        Content="Редактировать"
                        Command="{Binding EditCommand}"
                        ToolTip="Редактировать выбранный в таблице курс" />
                <Button Margin="0,0,8,8"
                        Padding="12,6"
                        Content="Опубликовать"
                        Command="{Binding PublishSelectedCommand}"
                        ToolTip="Включить выбранный курс в каталоге (is_active), если он сейчас скрыт" />
                <Button Margin="0,0,8,8" Padding="12,6" Content="В архив (выбранный)" Command="{Binding DeleteCommand}" />
                <Button Margin="0,0,8,8" Padding="12,6" Content="Сбросить фильтры" Command="{Binding ResetCommand}" />
            </WrapPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding CourseId}" Width="70" />
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="220" />
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="160" />
                <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="120" />
                <DataGridTextColumn Header="Экзамен" Binding="{Binding ExamName}" Width="100" />
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N0} ₽}" Width="100" />
                <DataGridTextColumn Header="Со скидкой" Binding="{Binding DiscountPrice, StringFormat={}{0:N0} ₽}" Width="100" />
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="72" />
                <DataGridTextColumn Header="Блоки" Binding="{Binding ModulesCount}" Width="60" />
                <DataGridTextColumn Header="Уроки" Binding="{Binding LessonsCount}" Width="60" />
                <DataGridTextColumn Header="Создан"
                                    Binding="{Binding CreatedAt, StringFormat=d}"
                                    Width="110" />
                <DataGridTemplateColumn Header="Действия" Width="320" MinWidth="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Button Margin="0,0,6,0"
                                        Padding="8,4"
                                        Content="Открыть"
                                        Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Margin="0,0,6,0"
                                        Padding="8,4"
                                        Content="Редактировать"
                                        Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Margin="0,0,0,0"
                                        Padding="8,4"
                                        Command="{Binding DataContext.PublishToggleRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Опубликовать"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Content" Value="Распубликовать"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
