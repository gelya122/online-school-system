<Window x:Class="online_school_admin.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Регистрация сотрудника"
        Height="720"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Новый сотрудник" />

            <TextBlock Margin="0,16,0,0" Text="Роль *" />
            <ComboBox Margin="0,4,0,0"
                      Padding="8,6"
                      DisplayMemberPath="Caption"
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}" />

            <TextBlock Margin="0,12,0,0" Text="Email *" />
            <TextBox Margin="0,4,0,0"
                     Padding="8,6"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,0" Text="Имя *" />
            <TextBox Margin="0,4,0,0"
                     Padding="8,6"
                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,0" Text="Фамилия *" />
            <TextBox Margin="0,4,0,0"
                     Padding="8,6"
                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,0" Text="Отчество" />
            <TextBox Margin="0,4,0,0"
                     Padding="8,6"
                     Text="{Binding Patronymic, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,0" Text="Телефон *" />
            <TextBox Margin="0,4,0,0"
                     Padding="8,6"
                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,0" Text="Дата рождения" />
            <DatePicker Margin="0,4,0,0"
                        SelectedDate="{Binding BirthDate, Mode=TwoWay}"
                        SelectedDateFormat="Short" />

            <TextBlock Margin="0,12,0,0" Text="Стаж (лет)" />
            <TextBox Margin="0,4,0,0"
                     Padding="8,6"
                     Text="{Binding Experience, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,0" Text="Аватар URL" />
            <TextBox Margin="0,4,0,0"
                     Padding="8,6"
                     Text="{Binding AvatarUrl, UpdateSourceTrigger=PropertyChanged}" />

            <Button Margin="0,8,0,0"
                    Padding="12,8"
                    Content="{Binding AvatarFileName, TargetNullValue=Загрузить аватар из файла...}"
                    Click="PickAvatar_OnClick" />

            <TextBlock Margin="0,12,0,0" Text="Пароль *" />
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,0" Padding="8,6" />

            <TextBlock Margin="0,12,0,0" Text="Повтор пароля *" />
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,0" Padding="8,6" />

            <TextBlock Margin="0,12,0,0"
                       MinHeight="36"
                       Foreground="#C0392B"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Padding="12,8"
                        Content="Отмена"
                        Click="CancelButton_OnClick" />
                <Button x:Name="SaveButton"
                        MinWidth="120"
                        Padding="12,8"
                        Content="Зарегистрировать"
                        Click="SaveButton_OnClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
