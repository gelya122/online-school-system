<UserControl x:Class="online_school_admin.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Style="{StaticResource ListPageDockPanel}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource PageTitleTextBlock}" Text="Студенты" />
                <Button Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" Content="Обновить" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Добавить" Command="{Binding AddCommand}" />
                <Button Content="Открыть" Command="{Binding OpenCommand}" />
                <Button Content="Редактировать" Command="{Binding EditCommand}" />
                <Button Content="{Binding ToggleActiveButtonCaption}" Command="{Binding ToggleActiveCommand}" />
                <Button Content="В архив (мягкое удаление)"
                        Command="{Binding SoftDeleteCommand}"
                        ToolTipService.ToolTip="deleted_at у студента и пользователя" />
                <Button Content="Записать на поток" Command="{Binding EnrollToInstanceCommand}" />
                <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" />
                <Button Content="Сбросить" Command="{Binding ResetCommand}" />
            </StackPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox Width="320"
                         Margin="0,0,8,8"
                         ToolTipService.ToolTip="ФИО, email, телефон, контакты родителей"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Width="200"
                          Margin="0,0,8,8"
                          Padding="8,5"
                          ToolTipService.ToolTip="Класс (0–11)"
                          DisplayMemberPath="Caption"
                          ItemsSource="{Binding ClassOptions}"
                          SelectedItem="{Binding SelectedClassFilter}" />

                <ComboBox Width="160"
                          Margin="0,0,8,8"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding IsActiveFilter}">
                    <ComboBoxItem Content="Все" Tag="{x:Null}" />
                    <ComboBoxItem Content="Активные" Tag="True" />
                    <ComboBoxItem Content="Неактивные" Tag="False" />
                </ComboBox>
            </WrapPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Text="{Binding PageSummary}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="|◀" Command="{Binding FirstPageCommand}" ToolTipService.ToolTip="Первая страница" />
                    <Button Style="{StaticResource SecondaryButton}" Content="◀" Command="{Binding PrevPageCommand}" ToolTipService.ToolTip="Назад" />
                    <Button Style="{StaticResource SecondaryButton}" Content="▶" Command="{Binding NextPageCommand}" ToolTipService.ToolTip="Вперёд" />
                    <Button Style="{StaticResource SecondaryButton}" Content="▶|" Command="{Binding LastPageCommand}" ToolTipService.ToolTip="Последняя страница" />
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource ErrorTextBlock}"
                       Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

            <Grid>
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding StudentId}" Width="70" SortMemberPath="StudentId" />
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="220" SortMemberPath="FullName" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" SortMemberPath="Email" />
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140" />
                        <DataGridTextColumn Header="Класс" Binding="{Binding ClassNumber}" Width="70" />
                        <DataGridTextColumn Header="Телефон родителя" Binding="{Binding ParentPhone}" Width="150" />
                        <DataGridTextColumn Header="Email родителя" Binding="{Binding ParentEmail}" Width="200" />
                        <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80" />
                        <DataGridTextColumn Header="Регистрация" Binding="{Binding RegisteredAt, StringFormat=dd.MM.yyyy}" Width="120" SortMemberPath="RegisteredAt" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#E6FFFFFF"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220"
                                     Height="6"
                                     IsIndeterminate="True"
                                     Foreground="{StaticResource Brush.Primary}" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Text="Загрузка…" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Brush.SurfaceMuted}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasAnyData}" Value="False" />
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource EmptyStateTextBlock}" />
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
