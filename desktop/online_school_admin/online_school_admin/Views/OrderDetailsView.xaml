<UserControl x:Class="online_school_admin.Views.OrderDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="Заказ" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Сохранить способ оплаты" Command="{Binding SaveCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Назад" Command="{Binding BackCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="#C0392B" Text="{Binding Error}" TextWrapping="Wrap" />

        <Border Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Details.OrderNumber}" />
                <TextBlock Margin="0,6,0,0" Foreground="#6B7280" Text="{Binding Details.StudentName}" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="#6B7280" Text="Статус: " />
                    <TextBlock Text="{Binding Details.Status}" />
                </StackPanel>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="#6B7280" Text="Создан: " />
                    <TextBlock Text="{Binding Details.CreatedAt, StringFormat=dd.MM.yyyy HH:mm, TargetNullValue=-}" />
                </StackPanel>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="#6B7280" Text="Оплачен: " />
                    <TextBlock Text="{Binding Details.PaidAt, StringFormat=dd.MM.yyyy HH:mm, TargetNullValue=-}" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" Text="{Binding Details.TotalAmount, StringFormat=Сумма: {0}}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding Details.DiscountAmount, StringFormat=Скидка: {0}}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding Details.FinalAmount, StringFormat=Итого: {0}}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding Details.PromoCode, StringFormat=Промокод: {0}, TargetNullValue=-}" />

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Width="200" Text="Способ оплаты (MethodId)" />
                    <TextBox Width="200" Padding="8,6" Text="{Binding MethodIdText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" FontSize="12"
                               Text="{Binding Details.Method, StringFormat=Текущее: {0}, TargetNullValue=-}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Margin="0,12,0,0"
                  ItemsSource="{Binding Details.Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Курс" Binding="{Binding CourseTitle}" Width="*" />
                <DataGridTextColumn Header="Поток" Binding="{Binding InstanceTitle}" Width="220" />
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100" />
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
