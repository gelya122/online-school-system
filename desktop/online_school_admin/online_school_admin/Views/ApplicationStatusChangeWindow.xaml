<Window x:Class="online_school_admin.Views.ApplicationStatusChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить статус"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480">
    <StackPanel Margin="16">
        <TextBlock Text="Клиент" Foreground="#6B7280" />
        <TextBlock x:Name="ClientBlock" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8" />

        <TextBlock Text="Телефон" Foreground="#6B7280" />
        <TextBlock x:Name="PhoneBlock" Margin="0,2,0,8" />

        <TextBlock Text="Текущий статус" Foreground="#6B7280" />
        <TextBlock x:Name="CurrentStatusBlock" Margin="0,2,0,12" />

        <TextBlock Text="Новый статус" Foreground="#6B7280" />
        <ComboBox x:Name="StatusCombo" DisplayMemberPath="StatusName" Margin="0,4,0,12" Height="28" />

        <TextBlock Text="Комментарий / причина" Foreground="#6B7280" />
        <TextBox x:Name="ReasonBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,4,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" Width="100" Margin="0,0,8,0" Padding="10,6" Click="Cancel_Click" />
            <Button Content="Сохранить" IsDefault="True" Width="110" Padding="10,6" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
