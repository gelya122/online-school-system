<UserControl x:Class="online_school_admin.Views.SchoolSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="Настройки школы" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Сохранить" Command="{Binding SaveCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="#C0392B" Text="{Binding Error}" TextWrapping="Wrap" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="School name" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding SchoolName}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Logo url" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding LogoUrl}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Phone" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding Phone}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Email" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding Email}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Address" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding Address}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="About text" />
                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Height="120"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Text="{Binding AboutText}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Privacy policy url" />
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding PrivacyPolicyUrl}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Terms url" />
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,0" Padding="8,6" Text="{Binding TermsUrl}" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>

