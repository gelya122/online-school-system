<UserControl x:Class="online_school_admin.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="{Binding ListTitle}" VerticalAlignment="Center" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Открыть" Command="{Binding OpenCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Взять в работу" Command="{Binding TakeInWorkCommand}"
                    Visibility="{Binding ShowExtendedApplicationFilters, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Назначить менеджера" Command="{Binding AssignManagerCommand}"
                    Visibility="{Binding ShowAdminAssignBar, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Изменить статус" Command="{Binding ChangeStatusCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Удалить" Command="{Binding DeleteCommand}"
                    Visibility="{Binding ShowAdminAssignBar, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid Width="240">
                <TextBox x:Name="SearchBox"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         ToolTipService.ToolTip="{Binding SearchFilterToolTip}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="12,0,0,0"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="Поиск"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NullOrWhiteSpaceToVisibilityConverter}}" />
            </Grid>

            <ComboBox Width="170" Margin="10,0,0,0" Height="28"
                      ItemsSource="{Binding Statuses}"
                      SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="StatusName"
                      ToolTipService.ToolTip="{Binding StatusFilterToolTip}"/>

            <ComboBox Width="200" Margin="10,0,0,0" Height="28"
                      DisplayMemberPath="Title"
                      ItemsSource="{Binding Managers}"
                      SelectedItem="{Binding SelectedManager}"
                      Visibility="{Binding ShowExtendedApplicationFilters, Converter={StaticResource BoolToVisibilityConverter}}"
                      ToolTipService.ToolTip="Менеджер (только «Все заявки»)"/>

            <ComboBox Width="200" Margin="10,0,0,0" Height="28"
                      DisplayMemberPath="Title"
                      ItemsSource="{Binding Subjects}"
                      SelectedItem="{Binding SelectedSubject}"
                      ToolTipService.ToolTip="Предмет в заявке"/>

            <!-- "Создана с/по" и "Применить" убраны по запросу -->
        </WrapPanel>

        <DataGrid ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ApplicationId}" Width="64" />
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="180" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" />
                <DataGridTextColumn Header="Класс" Binding="{Binding ClassNumber}" Width="56" />
                <DataGridTextColumn Header="Предметы" Binding="{Binding Subjects}" Width="200" />
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="120" />
                <DataGridTextColumn Header="Менеджер" Binding="{Binding ManagerName}" Width="130" />
                <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130" />
                <DataGridTemplateColumn Header="Действия" Width="*" MinWidth="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <Button Padding="8,5" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                        Content="Открыть"
                                        Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Padding="8,5" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                        Content="Взять в работу"
                                        Command="{Binding DataContext.TakeInWorkRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.ShowExtendedApplicationFilters, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Padding="8,5" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                        Content="Назначить менеджера"
                                        Visibility="{Binding DataContext.ShowAdminAssignBar, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.AssignManagerRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Padding="8,5" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                        Content="Изменить статус"
                                        Command="{Binding DataContext.ChangeStatusRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Padding="8,5" HorizontalAlignment="Stretch"
                                        Content="Удалить"
                                        Visibility="{Binding DataContext.ShowAdminAssignBar, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
