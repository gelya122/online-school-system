<UserControl x:Class="online_school_admin.Views.PromoCodeUsagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="Использования промокода" />
            <TextBlock Margin="10,4,0,0" Foreground="#6B7280" Text="{Binding PromoCode}" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Назад" Command="{Binding BackCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="220" />
                <DataGridTextColumn Header="Заказ" Binding="{Binding OrderNumber}" Width="180" />
                <DataGridTextColumn Header="Сумма скидки" Binding="{Binding DiscountAmount}" Width="120" />
                <DataGridTextColumn Header="Дата использования" Binding="{Binding UsedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="170" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

