<UserControl x:Class="online_school_admin.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="Журнал действий" />

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <WrapPanel>
                <Button Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
                <Button Margin="8,0,0,0" Padding="12,6" Content="Экспорт CSV" Command="{Binding ExportCommand}" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
                <ComboBox Width="240" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployeeFilter}"
                          DisplayMemberPath="FullName" />
                <TextBox Margin="8,0,0,0" Width="100" Padding="8,6" ToolTip="UserId" Text="{Binding UserIdFilterText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Margin="8,0,0,0" Width="140" Padding="8,6" ToolTip="Тип сущности" Text="{Binding EntityTypeText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Margin="8,0,0,0" Width="110" Padding="8,6" ToolTip="from yyyy-MM-dd" Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Margin="8,0,0,0" Width="110" Padding="8,6" ToolTip="to yyyy-MM-dd" Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Margin="8,0,0,0" Width="180" Padding="8,6" ToolTip="Поиск" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <Button Padding="12,6" Content="Назад" Command="{Binding PrevPageCommand}" />
                <Button Margin="8,0,0,0" Padding="12,6" Content="Вперёд" Command="{Binding NextPageCommand}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding PageInfo}" />
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#C0392B" Text="{Binding Error}" TextWrapping="Wrap" />

        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата (UTC)" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130" />
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeDisplay}" Width="160" />
                <DataGridTextColumn Header="Пользователь" Binding="{Binding UserDisplay}" Width="180" />
                <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="160" />
                <DataGridTextColumn Header="Сущность" Binding="{Binding EntityType}" Width="120" />
                <DataGridTextColumn Header="Id" Binding="{Binding EntityId}" Width="60" />
                <DataGridTextColumn Header="Было" Binding="{Binding OldValues}" Width="200" />
                <DataGridTextColumn Header="Стало" Binding="{Binding NewValues}" Width="200" />
                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120" />
                <DataGridTextColumn Header="User-Agent" Binding="{Binding UserAgent}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
