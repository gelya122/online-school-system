<UserControl x:Class="online_school_admin.Views.EnrollStudentToInstanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitleTextBlock}" Text="Записать на поток" />
            <Button Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="Записать" Command="{Binding EnrollCommand}" />
            <Button Margin="8,0,0,0" Content="Назад" Command="{Binding CancelCommand}" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBox Width="320"
                     Margin="0,0,8,8"
                     ToolTipService.ToolTip="Поиск по названию потока"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource ErrorTextBlock}"
                   Text="{Binding Error}"
                   Visibility="{Binding Error, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

        <Grid>
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding InstanceId}" Width="70" />
                    <DataGridTextColumn Header="Поток" Binding="{Binding Title}" Width="220" />
                    <DataGridTextColumn Header="Курс" Binding="{Binding CourseTitle}" Width="*" />
                    <DataGridTextColumn Header="Старт" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="120" />
                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="#E6FFFFFF"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220"
                                 Height="6"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource Brush.Primary}" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Text="Загрузка…" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

