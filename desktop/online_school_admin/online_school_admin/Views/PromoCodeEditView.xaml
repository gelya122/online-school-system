<UserControl x:Class="online_school_admin.Views.PromoCodeEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Сохранить" Command="{Binding SaveCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Отмена" Command="{Binding CancelCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#374151"
                   Text="{Binding CurrentUsesLine}"
                   TextWrapping="Wrap"
                   Visibility="{Binding CurrentUsesLine, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Code" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding Code}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Discount type" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                          DisplayMemberPath="Title"
                          ItemsSource="{Binding DiscountTypeOptions}"
                          SelectedItem="{Binding SelectedDiscountType}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Discount value" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding DiscountValueText}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Start date (yyyy-MM-dd)" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding StartDateText}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="End date (yyyy-MM-dd)" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding EndDateText}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Max uses" />
                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding MaxUsesText}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Min order amount" />
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding MinOrderAmountText}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Max discount amount" />
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" Padding="8,6" Text="{Binding MaxDiscountAmountText}" />

                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Applies to course" />
                <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,0,0,10"
                          DisplayMemberPath="Title"
                          ItemsSource="{Binding CourseOptions}"
                          SelectedItem="{Binding SelectedCourse}" />

                <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="Applies to instance" />
                <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,0,0,10"
                          DisplayMemberPath="Title"
                          ItemsSource="{Binding InstanceOptions}"
                          SelectedItem="{Binding SelectedInstance}" />

                <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="Is active" />
                <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,0,0,0" IsChecked="{Binding IsActive}" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>

