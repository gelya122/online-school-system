<UserControl x:Class="online_school_admin.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitleTextBlock}" Text="Сотрудники" />

            <TextBlock Margin="0,4,0,0"
                       Foreground="#6B7280"
                       FontSize="12"
                       Text="Поиск по ФИО (включая отчество), email, телефону" />
            <WrapPanel Margin="0,10,0,0">
                <TextBox Width="320"
                         Margin="0,0,8,8"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         ToolTip="ФИО, email или телефон"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Width="200"
                          Margin="0,0,8,8"
                          Padding="8,5"
                          DisplayMemberPath="Caption"
                          ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRoleFilter}"
                          ToolTip="Фильтр по роли (роль «ученик» в списке не показывается)" />

                <Button Margin="0,0,8,8" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
                <Button Margin="0,0,8,8" Padding="12,6" Content="Добавить" Command="{Binding AddCommand}" />
                <Button Margin="0,0,8,8" Padding="12,6" Content="Открыть" Command="{Binding OpenCommand}" />
                <Button Margin="0,0,8,8" Padding="12,6" Content="Редактировать" Command="{Binding EditCommand}" />
                <Button Margin="0,0,8,8"
                        Padding="12,6"
                        Content="{Binding ToggleActiveButtonCaption}"
                        Command="{Binding ToggleActiveCommand}" />
                <Button Margin="0,0,8,8"
                        Padding="12,6"
                        Content="В архив (мягкое удаление)"
                        Command="{Binding SoftDeleteCommand}"
                        ToolTip="Устанавливает deleted_at у сотрудника и пользователя, без физического удаления" />
                <Button Margin="0,0,8,8" Padding="12,6" Content="Сбросить" Command="{Binding ResetCommand}" />
            </WrapPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EmployeeId}" Width="70" />
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="220" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140" />
                <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="140" />
                <DataGridTextColumn Header="Опыт" Binding="{Binding Experience}" Width="70" />
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80" />
                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

