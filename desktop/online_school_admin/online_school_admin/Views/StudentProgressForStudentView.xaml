<UserControl x:Class="online_school_admin.Views.StudentProgressForStudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitleTextBlock}" Text="Прогресс студента" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Открыть прогресс" Command="{Binding OpenEnrollmentCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource ErrorTextBlock}"
                   Text="{Binding Error}"
                   Visibility="{Binding Error, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

        <DataGrid ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Поток" Binding="{Binding InstanceName}" Width="200" />
                <DataGridTextColumn Header="Курс" Binding="{Binding CourseTitle}" Width="*" />
                <DataGridTextColumn Header="Уроков" Binding="{Binding TotalLessons}" Width="70" />
                <DataGridTextColumn Header="Завершено" Binding="{Binding CompletedLessons}" Width="90" />
                <DataGridTextColumn Header="%" Binding="{Binding Percent}" Width="50" />
                <DataGridTextColumn Header="ДЗ всего" Binding="{Binding TotalHomeworkCount}" Width="80" />
                <DataGridTextColumn Header="Сдано ДЗ" Binding="{Binding SubmittedHomeworkCount}" Width="90" />
                <DataGridTextColumn Header="Средний" Binding="{Binding AverageScore}" Width="80" />
                <DataGridTextColumn Header="Сумма баллов" Binding="{Binding TotalHomeworkScore}" Width="100" />
                <DataGridTextColumn Header="Макс. ДЗ" Binding="{Binding TotalHomeworkMaxPoints}" Width="90" />
                <DataGridTextColumn Header="Активность" Binding="{Binding LastActivityAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
