<UserControl x:Class="online_school_admin.Views.SiteBannersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="Баннеры сайта" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Добавить" Command="{Binding AddCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Редактировать" Command="{Binding EditCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Удалить" Command="{Binding DeleteCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Вверх" Command="{Binding MoveUpCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Вниз" Command="{Binding MoveDownCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Показать/скрыть" Command="{Binding ToggleActiveCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Назад" Command="{Binding BackCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="#C0392B" Text="{Binding Error}" TextWrapping="Wrap" />

        <DataGrid ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Порядок" Binding="{Binding BannerOrder}" Width="80" />
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70" />
                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="220" />
                <DataGridTextColumn Header="Подзаголовок" Binding="{Binding Subtitle}" Width="220" />
                <DataGridTextColumn Header="ImageUrl" Binding="{Binding ImageUrl}" Width="220" />
                <DataGridTextColumn Header="Кнопка" Binding="{Binding ButtonText}" Width="140" />
                <DataGridTextColumn Header="Url" Binding="{Binding ButtonUrl}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

