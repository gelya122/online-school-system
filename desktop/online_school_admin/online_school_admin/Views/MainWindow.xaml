<Window x:Class="online_school_admin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:online_school_admin.ViewModels"
        mc:Ignorable="d"
        Title="Администрирование — онлайн-школа"
        Height="720"
        Width="1200"
        MinHeight="560"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="SidebarListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="LeftAccent"
                                        Width="4"
                                        Margin="0,6,0,6"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        CornerRadius="2" />
                                <ContentPresenter Margin="14,10,12,10"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8ECF1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2EAF6" />
                                <Setter TargetName="LeftAccent" Property="Background" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="12,8"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Text="{Binding UserDisplayName}" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="#6B7280"
                               Text="{Binding UserEmail}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#374151"
                               Text="{Binding UserRoleLine}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Content="Выйти из аккаунта"
                        Command="{Binding LogoutCommand}" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F2F4F7"
                    BorderBrush="#D8DEE6"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8,0,8">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="16,4,16,12"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#5C6370"
                               Text="РАЗДЕЛЫ" />
                    <ListBox Margin="4,0,8,0"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding NavItems}"
                             ItemContainerStyle="{StaticResource SidebarListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SidebarNavItem}">
                                <StackPanel>
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"
                                               Text="{Binding Title}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               Text="{Binding Subtitle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="24"
                    Padding="24"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8">
                <ContentControl Content="{Binding Navigation.CurrentViewModel}" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
