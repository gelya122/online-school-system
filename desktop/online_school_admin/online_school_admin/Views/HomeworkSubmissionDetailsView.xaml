<UserControl x:Class="online_school_admin.Views.HomeworkSubmissionDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Panel.ZIndex="1"
                Background="#E6FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220" Height="6" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="#6B7280" Text="Загрузка…" />
            </StackPanel>
        </Border>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="Проверка ДЗ" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Зачесть" Command="{Binding ApproveCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="На доработку" Command="{Binding RequestRevisionCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Отклонить" Command="{Binding RejectCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Padding="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Студент" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Details.StudentName}" />
                        <TextBlock Foreground="#6B7280" Text="{Binding Details.StudentEmail}" />
                        <TextBlock Foreground="#6B7280" Text="{Binding Details.StudentPhone}" />

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Курс / поток / урок" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Details.CourseTitle}" />
                        <TextBlock Foreground="#6B7280" Text="{Binding Details.InstanceName}" />
                        <TextBlock Foreground="#6B7280" Text="{Binding Details.LessonTitle}" />
                        <TextBlock Foreground="#6B7280" Text="{Binding Details.HomeworkTitle}" />

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Статус / балл" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Details.Status}" />
                        <TextBlock Foreground="#6B7280" Text="{Binding Details.TotalScore, StringFormat=TotalScore: {0}}" />

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Проверяющий" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox Width="240"
                                      DisplayMemberPath="Title"
                                      ItemsSource="{Binding ReviewerOptions}"
                                      SelectedItem="{Binding SelectedReviewer}" />
                            <Button Margin="8,0,0,0" Padding="12,6" Content="Назначить" Command="{Binding AssignReviewerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,16,0,8" FontSize="16" FontWeight="SemiBold" Text="Задания" />
                <DataGrid ItemsSource="{Binding Tasks}"
                          SelectedItem="{Binding SelectedTask}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          RowHeaderWidth="0"
                          Height="340">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ручная" Binding="{Binding NeedsManualReview}" Width="70" />
                        <DataGridTextColumn Header="Тип" Binding="{Binding TaskType}" Width="110" />
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxPointsDecimal}" Width="70" />
                        <DataGridTextColumn Header="Балл" Binding="{Binding PointsAwarded}" Width="70" />
                        <DataGridTextColumn Header="Авто" Binding="{Binding AutoCheckResult}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="2" Padding="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Текст задания" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding SelectedTask.TaskText}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Ответ студента" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding SelectedTask.StudentAnswerText}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Файл" />
                        <TextBlock Margin="0,6,0,0" Foreground="#6B7280" Text="{Binding SelectedTask.AttachedFileName}" TextWrapping="Wrap" />
                        <TextBlock Foreground="#6B7280" Text="{Binding SelectedTask.AttachedFileUrl}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Автопроверка" />
                        <TextBlock Margin="0,6,0,0" Foreground="#6B7280" Text="{Binding SelectedTask.AutoCheckResult}" />

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Проверка (только для заданий с флагом «Ручная»)" />
                        <TextBlock Margin="0,4,0,0" Foreground="#6B7280" FontSize="12"
                                   Text="{Binding SelectedTask.MaxPointsDecimal, StringFormat=Максимум баллов: {0}}" />

                        <StackPanel Margin="0,8,0,0" Width="200">
                            <TextBlock Foreground="#6B7280" Text="points_awarded" />
                            <TextBox Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" Foreground="#6B7280" Text="teacher_comment" />
                        <TextBox Text="{Binding TeacherComment, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 Height="100"
                                 TextWrapping="Wrap" />

                        <Button Margin="0,12,0,0" Padding="12,6" Content="Сохранить проверку" Command="{Binding SaveTaskReviewCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
    </Grid>
</UserControl>

