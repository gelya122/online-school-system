<UserControl x:Class="online_school_admin.Views.EnrolledStudentDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Padding="12,6" Content="← Назад к потоку" Command="{Binding BackCommand}" />
            <TextBlock Margin="16,0,0,0" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Text="{Binding BreadcrumbText}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <TabControl>
            <TabItem Header="Основная информация">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Margin="0,12,0,0" Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding FullNameDisplay}" />
                            <TextBlock Margin="0,8,0,0" Foreground="#6B7280" Text="{Binding Student.Email, StringFormat=Email: {0}}" />
                            <TextBlock Margin="0,4,0,0" Foreground="#6B7280" Text="{Binding Student.Phone, StringFormat=Телефон: {0}}" />
                            <TextBlock Margin="0,4,0,0" Foreground="#6B7280" Text="{Binding Student.ClassNumber, StringFormat=Класс: {0}}" />
                            <TextBlock Margin="0,4,0,0" Foreground="#6B7280" Text="{Binding Student.IsActive, StringFormat=Активен: {0}}" />
                            <TextBlock Margin="0,12,0,0" Foreground="#6B7280" TextWrapping="Wrap"
                                       Text="{Binding Student.ParentEmail, StringFormat=Родитель (email): {0}}" />
                            <TextBlock Margin="0,4,0,0" Foreground="#6B7280" TextWrapping="Wrap"
                                       Text="{Binding Student.ParentPhone, StringFormat=Родитель (тел.): {0}}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Прогресс">
                <Border Margin="0,12,0,0" Padding="16" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                    <TextBlock Foreground="#6B7280" TextWrapping="Wrap"
                               Text="Раздел «Прогресс» по записи на этот поток будет добавлен позже." />
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
