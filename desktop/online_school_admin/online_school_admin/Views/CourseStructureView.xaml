<UserControl x:Class="online_school_admin.Views.CourseStructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:online_school_admin.ViewModels"
             >
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:CourseModuleTreeGroup}" ItemsSource="{Binding LessonItems}">
            <HierarchicalDataTemplate.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LessonTreeNode}">
                    <TextBlock Padding="4,2,0,2"
                               Foreground="#374151"
                               Text="{Binding DisplayText}"
                               TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </HierarchicalDataTemplate.ItemTemplate>
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#6B7280"
                           FontSize="12"
                           Text="{Binding LessonItems.Count, StringFormat={}{0} урок.}" />
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding HeaderText}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: действия + дерево -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Структура курса" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Padding="8,4"
                                ToolTip="Переместить блок выше"
                                Content="↑"
                                Command="{Binding MoveModuleUpCommand}" />
                        <Button Margin="4,0,0,0"
                                Padding="8,4"
                                ToolTip="Переместить блок ниже"
                                Content="↓"
                                Command="{Binding MoveModuleDownCommand}" />
                    </StackPanel>
                </DockPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <Button Margin="0,0,8,8"
                            Padding="14,8"
                            Style="{StaticResource PrimaryButton}"
                            Content="+ Добавить блок"
                            Command="{Binding AddModuleCommand}" />
                    <Button Margin="0,0,8,8"
                            Padding="14,8"
                            Content="+ Добавить урок"
                            Command="{Binding AddLessonCommand}" />
                </WrapPanel>

                <Border Grid.Row="2"
                        Padding="0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TreeView x:Name="StructureTree"
                              Padding="4"
                              BorderThickness="0"
                              Background="Transparent"
                              ItemsSource="{Binding ModuleGroups}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="2,4" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Border>

                <TextBlock Grid.Row="3"
                           Margin="0,10,0,0"
                           Foreground="#6B7280"
                           FontSize="12"
                           Text="{Binding StructureSummary}" />
            </Grid>

            <!-- Правая колонка: блок или урок -->
            <Grid Grid.Column="2">
                <!-- Редактор блока -->
                <Border Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding ShowBlockEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Блок курса" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsNewModuleDraft, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="Заполните поля и нажмите «Сохранить блок», чтобы добавить блок в курс." />

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Название блока *" />
                            <TextBox Text="{Binding ModuleTitle, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsReadOnly}" />

                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Описание" />
                            <TextBox MinHeight="72"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Text="{Binding ModuleDescription, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <StackPanel Width="120">
                                    <TextBlock Style="{StaticResource FormCaptionTextBlock}" Text="Порядок" />
                                    <TextBox Text="{Binding ModuleOrder, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsReadOnly}" />
                                </StackPanel>
                                <CheckBox Margin="20,20,0,0"
                                          VerticalAlignment="Center"
                                          Content="Блок активен"
                                          IsChecked="{Binding ModuleIsActive}"
                                          IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}" />
                            </StackPanel>

                            <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                                <Button Padding="14,8"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Сохранить блок"
                                        Command="{Binding SaveModuleCommand}" />
                                <Button Margin="10,0,0,0"
                                        Padding="14,8"
                                        Content="Скрыть блок"
                                        Command="{Binding DeleteModuleCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNewModuleDraft}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Редактор урока -->
                <Border Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding ShowLessonEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock FontSize="18" FontWeight="SemiBold">
                                    <Run Text="Урок: " />
                                    <Run Text="{Binding LessonTitle, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="#6B7280"
                                           FontSize="12"
                                           Visibility="{Binding IsNewLessonDraft, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="Новый урок — сохраните, затем можно добавить материалы и ДЗ." />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Margin="16,0,0,0"
                                    Padding="14,8"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource Brush.Danger}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Foreground="{StaticResource Brush.Danger}"
                                    Content="Удалить урок"
                                    Command="{Binding DeleteLessonCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewLessonDraft}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DockPanel>

                        <TabControl Grid.Row="1">
                            <TabItem Header="Основное">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FormCaptionTextBlock}" Text="Название урока *" />
                                                <TextBox Text="{Binding LessonTitle, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsReadOnly}" />

                                                <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Описание" />
                                                <TextBox MinHeight="90"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         IsReadOnly="{Binding IsReadOnly}"
                                                         Text="{Binding LessonContent, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Видео (URL)" />
                                                <TextBox Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsReadOnly}" />
                                                <Button Margin="0,8,0,0"
                                                        HorizontalAlignment="Left"
                                                        Padding="12,6"
                                                        Content="Загрузить видео с устройства…"
                                                        Command="{Binding UploadLessonVideoCommand}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FormCaptionTextBlock}" Text="Тип урока *" />
                                                <ComboBox DisplayMemberPath="Title"
                                                          IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                                                          ItemsSource="{Binding LessonTypes}"
                                                          SelectedValue="{Binding LessonTypeId}"
                                                          SelectedValuePath="Id"/>

                                                <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Порядок в блоке *" />
                                                <TextBox Text="{Binding LessonOrder, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding LessonOrderFieldIsReadOnly}" />

                                                <TextBlock Margin="0,12,0,0" Style="{StaticResource FormCaptionTextBlock}" Text="Длительность (минуты)" />
                                                <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsReadOnly}" />

                                                <CheckBox Margin="0,16,0,0"
                                                          Content="Урок активен (опубликован в структуре)"
                                                          IsChecked="{Binding LessonIsActive}"
                                                          IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Margin="0,0,8,0"
                                                    Padding="10,6"
                                                    ToolTip="Порядок уроков в блоке"
                                                    Content="↑"
                                                    IsEnabled="{Binding IsNewLessonDraft, Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding MoveLessonUpCommand}" />
                                            <Button Padding="10,6"
                                                    Content="↓"
                                                    IsEnabled="{Binding IsNewLessonDraft, Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding MoveLessonDownCommand}" />
                                        </StackPanel>

                                        <Separator Margin="0,20,0,16" />

                                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="Материалы урока" />
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <Button Margin="0,0,8,0"
                                                        Padding="12,6"
                                                        Style="{StaticResource PrimaryButton}"
                                                        ToolTip="Выбрать файл на компьютере и загрузить на сервер"
                                                        Content="+ Добавить материал"
                                                        Command="{Binding AddMaterialCommand}" />
                                                <Button Padding="10,6"
                                                        ToolTip="Сначала заполните поля «Название» и «URL» ниже"
                                                        Content="По ссылке…"
                                                        Command="{Binding AddMaterialFromUrlCommand}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock Margin="0,0,0,8"
                                                   Foreground="#6B7280"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Text="Файл: «Добавить материал» открывает проводник и загружает файл на сервер. Ссылка: введите название и URL в полях ниже и нажмите «По ссылке…»." />

                                        <DataGrid MinHeight="140"
                                                  MaxHeight="220"
                                                  ItemsSource="{Binding Materials}"
                                                  SelectedItem="{Binding SelectedMaterial}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  RowHeaderWidth="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Название" Binding="{Binding FileName}" Width="*" />
                                                <DataGridTextColumn Header="Тип" Binding="{Binding FileType}" Width="100" />
                                                <DataGridTextColumn Header="Файл / ссылка" Binding="{Binding FileUrl}" Width="2*" />
                                                <DataGridTextColumn Header="КБ" Binding="{Binding FileSizeKb}" Width="56" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource FormCaptionTextBlock}" Text="Название материала" />
                                                <TextBox Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsReadOnly}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Style="{StaticResource FormCaptionTextBlock}" Text="URL" />
                                                <TextBox Text="{Binding MaterialUrl, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsReadOnly}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <Button Padding="12,6"
                                                    Content="Сохранить материал"
                                                    Command="{Binding SaveMaterialCommand}" />
                                            <Button Margin="8,0,0,0"
                                                    Padding="12,6"
                                                    Content="Удалить материал"
                                                    Command="{Binding DeleteMaterialCommand}" />
                                        </StackPanel>

                                        <Button Margin="0,24,0,0"
                                                HorizontalAlignment="Right"
                                                Padding="16,10"
                                                Style="{StaticResource PrimaryButton}"
                                                Content="Сохранить урок"
                                                Command="{Binding SaveLessonCommand}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Домашнее задание">
                                <StackPanel Margin="12,16,12,12">
                                    <TextBlock Foreground="#374151"
                                               TextWrapping="Wrap"
                                               Text="Домашнее задание (assignment и вопросы test_question) открывается в отдельном окне после сохранения урока." />
                                    <Button Margin="0,16,0,0"
                                            HorizontalAlignment="Left"
                                            Padding="14,8"
                                            Content="Открыть редактор ДЗ…"
                                            Command="{Binding OpenLessonCommand}" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
