<UserControl x:Class="online_school_admin.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="Аналитика" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <ComboBox Margin="12,0,0,0" Width="220"
                      ItemsSource="{Binding PeriodOptions}"
                      SelectedItem="{Binding SelectedPeriod}" />
            <TextBox Margin="12,0,0,0" Width="120" Padding="8,6" VerticalContentAlignment="Center"
                     ToolTip="from (yyyy-MM-dd)"
                     Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Margin="8,0,0,0" Width="120" Padding="8,6" VerticalContentAlignment="Center"
                     ToolTip="to (yyyy-MM-dd)"
                     Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="#C0392B" Text="{Binding Error}" TextWrapping="Wrap" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <WrapPanel>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Новые заявки" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.NewApplications}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Конверсия в студента" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.ApplicationToStudentConversion, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Конверсия в оплату" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.ApplicationToPaymentConversion, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Выручка" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.Revenue}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Оплаченные заказы" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.PaidOrders}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Неоплаченные заказы" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.UnpaidOrders}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Активные студенты" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.ActiveStudents}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Активные потоки" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.ActiveStreams}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Средний прогресс" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.AverageProgressPercent, StringFormat={}{0}%}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Средний балл ДЗ" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.AverageHomeworkScore}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="ДЗ на проверке" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.HomeworkOnReview}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Промокоды (исп.)" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.PromoCodeUsages}" />
                        </StackPanel>
                    </Border>
                    <Border Width="260" Padding="12" Margin="0,0,12,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="Скидки по промокодам" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Summary.PromoCodeDiscountTotal}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <TextBlock Margin="0,8,0,6" FontSize="16" FontWeight="SemiBold" Text="Заявки по дням" />
                <DataGrid ItemsSource="{Binding ApplicationsByDay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="160" />
                        <DataGridTextColumn Header="Заявки" Binding="{Binding Count}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,16,0,6" FontSize="16" FontWeight="SemiBold" Text="Выручка по дням" />
                <DataGrid ItemsSource="{Binding RevenueByDay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="160" />
                        <DataGridTextColumn Header="Выручка" Binding="{Binding Amount}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,16,0,6" FontSize="16" FontWeight="SemiBold" Text="Оплаты по статусам" />
                <DataGrid ItemsSource="{Binding PaymentsByStatus}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,16,0,6" FontSize="16" FontWeight="SemiBold" Text="Прогресс по курсам" />
                <DataGrid ItemsSource="{Binding ProgressByCourse}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Курс" Binding="{Binding Name}" Width="320" />
                        <DataGridTextColumn Header="Средний прогресс, %" Binding="{Binding Percent}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,16,0,6" FontSize="16" FontWeight="SemiBold" Text="ДЗ на проверке по курсам" />
                <DataGrid ItemsSource="{Binding HomeworkOnReviewByCourse}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Курс" Binding="{Binding Name}" Width="320" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,16,0,6" FontSize="16" FontWeight="SemiBold" Text="Популярные курсы (оплаченные позиции в периоде)" />
                <DataGrid ItemsSource="{Binding PopularCourses}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Курс" Binding="{Binding Name}" Width="360" />
                        <DataGridTextColumn Header="Позиций в заказах" Binding="{Binding Count}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,16,0,6" FontSize="16" FontWeight="SemiBold" Text="Использование промокодов" />
                <DataGrid ItemsSource="{Binding PromoUsage}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="180" />
                        <DataGridTextColumn Header="Использований" Binding="{Binding Uses}" Width="120" />
                        <DataGridTextColumn Header="Скидка итого" Binding="{Binding DiscountTotal}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

