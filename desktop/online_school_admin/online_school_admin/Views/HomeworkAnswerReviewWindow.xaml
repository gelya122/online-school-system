<Window x:Class="online_school_admin.Views.HomeworkAnswerReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка ДЗ"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="720">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Студент" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Details.StudentName}" />
                    <TextBlock Foreground="#6B7280" Text="{Binding Details.StudentEmail, TargetNullValue=—}" />

                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Курс / поток / урок" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Details.CourseTitle}" />
                    <TextBlock Foreground="#6B7280" Text="{Binding Details.InstanceName}" />
                    <TextBlock Foreground="#6B7280" Text="{Binding Details.LessonTitle}" />
                    <TextBlock Foreground="#6B7280" Text="{Binding Details.HomeworkTitle}" />

                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Максимальный балл" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Task.MaxPointsDecimal, TargetNullValue=—}" />

                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Балл" />
                    <TextBox Margin="0,6,0,0"
                             Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Комментарий" />
                    <TextBox Margin="0,6,0,0"
                             AcceptsReturn="True"
                             Height="110"
                             TextWrapping="Wrap"
                             Text="{Binding TeacherComment, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Текст задания" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Task.TaskText}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Ответ студента" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Task.StudentAnswerText}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Width="110" Padding="12,6" Margin="0,0,8,0" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Сохранить" Width="120" Padding="12,6" IsDefault="True" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>

