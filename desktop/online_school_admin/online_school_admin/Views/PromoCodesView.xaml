<UserControl x:Class="online_school_admin.Views.PromoCodesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="Промокоды" />
            <Button Margin="16,0,0,0" Padding="12,6" Content="Обновить" Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Добавить" Command="{Binding AddCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Редактировать" Command="{Binding EditCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Активировать" Command="{Binding ActivateCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Отключить" Command="{Binding DeactivateCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Использования" Command="{Binding UsagesCommand}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Удалить" Command="{Binding DeleteCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,12"
                   Foreground="#C0392B"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Width="260"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox Width="220" Margin="10,0,0,0"
                      DisplayMemberPath="Title"
                      ItemsSource="{Binding ActiveOptions}"
                      SelectedItem="{Binding SelectedActive}" />

            <Button Margin="10,0,0,0" Padding="12,6" Content="Применить" Command="{Binding RefreshCommand}" />
        </WrapPanel>

        <DataGrid ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="120" />
                <DataGridTextColumn Header="Тип" Binding="{Binding DiscountTypeName}" Width="120" />
                <DataGridTextColumn Header="Значение" Binding="{Binding DiscountValue}" Width="90" />
                <DataGridTextColumn Header="Мин. заказ" Binding="{Binding MinOrderAmount}" Width="100" />
                <DataGridTextColumn Header="Макс. скидка" Binding="{Binding MaxDiscountAmount}" Width="100" />
                <DataGridTextColumn Header="Начало" Binding="{Binding ValidFrom, StringFormat=dd.MM.yyyy}" Width="110" />
                <DataGridTextColumn Header="Окончание" Binding="{Binding ValidUntil, StringFormat=dd.MM.yyyy}" Width="110" />
                <DataGridTextColumn Header="Макс. использований" Binding="{Binding MaxUses}" Width="130" />
                <DataGridTextColumn Header="Использований" Binding="{Binding CurrentUses}" Width="110" />
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70" />
                <DataGridTextColumn Header="Курс" Binding="{Binding AppliesToCourseTitle}" Width="200" />
                <DataGridTextColumn Header="Поток" Binding="{Binding AppliesToInstanceTitle}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

